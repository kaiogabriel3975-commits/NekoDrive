<?xml version="1.0" encoding="utf-8"?>
<!--
  O que o Android copia para a nuvem (backup) e para um aparelho novo.
  Só as preferências do app (contas listadas, favoritos, capas, posição dos vídeos, ajustes).
  Ficam de fora: o log de funcionamento (filesDir) e todos os caches (fotos e vídeos), que são grandes e se refazem.
  Fica de fora também o token de renovação do Google (tokens_renovacao): ele só abre com a chave do Keystore deste
  aparelho. Em um aparelho novo o app pede o login de novo.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="tokens_renovacao.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="tokens_renovacao.xml" />
    </device-transfer>
</data-extraction-rules>
